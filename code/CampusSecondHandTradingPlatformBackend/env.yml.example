# ===================================================
# 校园二手交易平台 - 环境变量配置
# ===================================================

# dev | prod
profiles-active: prod

server-port: 8080

# ---- 数据库配置 ----
db:
  # dev: sqlite
  #   url 写法：./data/demo.db
  #       注：该数据使用前需要先创建对应目录
  # prod: mysql
  #   url 写法： //localhost:3306/demo
  url: your-db-url
  username: your-db-username
  password: your-db-password

external:
  # ---- CORS 配置 ----
  cors:
    # 填写请求源端点，多个用“,”隔开
    allow-origins: "*"

  # ---- JWT 配置 ----
  jwt:
    # JWT 签名密钥 明文
    secret: your-jwt-secret
    # JWT 过期时间（毫秒），默认24小时
    expiration: 86400

  # ---- 在线聊天配置 ----
  chat:
    # 聊天加密密钥 明文
    secret: your-chat-secret

  # ---- 对象存储配置 ----
  s3:
    config:
      # 存储提供商: r2 | oss
      storage-support: r2
      # 账户 ID
      #   对于 R2，在 Cloudflare 控制台 → R2 → 账户设置中查看；
      #   对于 OSS，...
      account-id: your-account-id
      # Access Key ID
      #   对于 R2，在 Cloudflare 控制台 → R2 → 管理 API 令牌中创建；
      #   对于 OSS，...
      access-key: your-access-key
      # Secret Access Key
      secret-key: your-secret-access-key
      # Endpoint URL
      #   R2 格式：https://<account-id>.r2.cloudflarestorage.com；
      #   OSS 格式：...
      endpoint: https://endpoint.com
      # 存储桶名称
      bucket-name: your-bucket-name
      # 存储桶中的子文件夹路径（可选）
      child-folder: example/folder/
      # 自定义域名或公共URL（用于图片访问）
      cdn-domain: https://example.com
      # R2 区域（固定为 auto）；OSS 可不填
      region: auto