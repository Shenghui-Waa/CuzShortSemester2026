# ===================================================
# 校园二手交易平台 - 环境变量配置
# ===================================================

# dev | prod
profiles-active: dev

server-port: 8080

# ---- 数据库配置 ----
db:
  # dev: sqlite
  #   url 写法：./data/dbname.db
  # prod: mysql
  #   url 写法： //localhost:3306/demo
  url: ./data/dev.db
#  url: //192.168.110.128:3306/cuzssp
  username: root
  password: 123456

# ---- 文件上传配置 ----
upload:
  max:
    size:
      file: 2MB
      request: 10MB

external:
  # ---- JWT 配置 ----
  jwt:
    # JWT 签名密钥 明文
    secret: cuzssp2026webproject
    # JWT 过期时间（毫秒），默认24小时
    expiration: 21600000

  # ---- 在线聊天配置 ----
  chat:
    # 聊天加密密钥 明文
    secret: cuzssp2026webproject

  # ---- 对象存储配置 ----
  s3:
    config:
      # 存储提供商: r2 | oss
      storage-support: r2
      # 账户 ID
      #   对于 R2，在 Cloudflare 控制台 → R2 → 账户设置中查看；
      #   对于 OSS，...
      account-id: 455a8b58714ae5eb276aedbdcf02c2ed
      # Access Key ID
      #   对于 R2，在 Cloudflare 控制台 → R2 → 管理 API 令牌中创建；
      #   对于 OSS，...
      access-key: fe1ae63ba486da91550e45d17b726259
      # Secret Access Key
      secret-key: fb4e7de85b00f90d44be6f8c9bb1e6a2c5dbe1919abe3164ddbbaf3853c00e14
      # 存储桶名称
      endpoint: https://455a8b58714ae5eb276aedbdcf02c2ed.r2.cloudflarestorage.com
      # 存储桶中的子文件夹路径（可选）
      bucket-name: r2-joss-tsyanst
      # Endpoint URL
      #   R2 格式：https://<account-id>.r2.cloudflarestorage.com；
      #   OSS 格式：...
      child-folder: cuzssp/2026/files/
      # 自定义域名或公共URL（用于图片访问）
      cdn-domain: https://r2.josstyanaaa.cc.cd
      # R2 区域（固定为 auto）；OSS 可不填
      region: auto