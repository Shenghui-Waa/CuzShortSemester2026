<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cuzssp.campussecondhandtradingplatformbackend.mapper.UserMapper">
    <update id="updateProfileFields">
        UPDATE user
        <set>
            <if test="request.nickname != null">nickname = #{request.nickname},</if>
            <if test="request.phone != null">phone = #{request.phone},</if>
            <if test="request.email != null">email = #{request.email},</if>
            <if test="request.school != null">school = #{request.school},</if>
            <if test="request.campus != null">campus = #{request.campus},</if>
            updated_at = #{updatedAt}
        </set>
        WHERE id = #{userId}
    </update>
</mapper>
