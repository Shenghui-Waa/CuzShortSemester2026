<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cuzssp.campussecondhandtradingplatformbackend.mapper.ProductMapper">
    <select id="selectByKeywordOrCategoryOrCampusOrStatus"
            resultType="com.cuzssp.campussecondhandtradingplatformbackend.common.entity.Product">
        SELECT * FROM product
        <where>
            <if test="keyword != null and !keyword.isBlank()">
                <bind name="pattern" value="'%' + keyword + '%'"/>
                AND (title LIKE #{pattern} OR description LIKE #{pattern})
            </if>
            <if test="categoryId != null">AND category_id = #{categoryId}</if>
            <if test="campus != null and !campus.isBlank()">AND campus = #{campus}</if>
            <if test="status != null">AND status = #{status}</if>
        </where>
        ORDER BY price ASC, created_at DESC, id DESC
    </select>
</mapper>
